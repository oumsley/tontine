generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  fullName    String?
  pinHash     String?
  kycStatus   KycStatus @default(UNVERIFIED)
  // Placeholder pending the full 5-dimension engine (Module 4): bumped to a
  // flat value on KYC verification so the catalog's eligibility gate has
  // something real to check against.
  trustScore  Int      @default(0)
  isOrganizer          Boolean   @default(false)
  organizerActivatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  otpCodes         OtpCode[]
  kycDocuments     KycDocument[]
  sessions         Session[]
  wallet           Wallet?
  initiatedTxns    Transaction[]
  subscriptions    TontineSubscription[]
  organizerActivation     OrganizerActivation?
  createdProducts         TontineProduct[]          @relation("ProductCreator")
  validatorOf             TontineValidator[]
  requestedDisbursements  DisbursementRequest[]     @relation("DisbursementRequester")
  disbursementValidations DisbursementValidation[]
}

// The "KYA -> acceptation des responsabilités -> activation" gate: a user
// can only become an organizer once, after KYC is verified, by explicitly
// accepting the organizer responsibilities terms.
model OrganizerActivation {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  acceptedAt    DateTime @default(now())
  termsSnapshot Json
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model KycDocument {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  idDocumentPath  String
  selfiePath      String
  status          KycStatus @default(PENDING)
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([userId])
}

enum TransactionType {
  TOPUP
  TRANSFER
  WITHDRAWAL
  PAYMENT
  AIRTIME_PURCHASE
  TONTINE_CONTRIBUTION
  TONTINE_DISBURSEMENT
}

enum TransactionStatus {
  COMPLETED
  FAILED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

// Amounts are whole-number FCFA (XOF has no minor subdivision in practice),
// stored as Int to avoid floating point drift entirely.
model Wallet {
  id        String   @id @default(uuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  isMerchant Boolean @default(false)
  balance   Int      @default(0)
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  merchant      Merchant?
  tontineGroup  TontineGroup?
}

model Merchant {
  id          String   @id @default(uuid())
  displayName String
  qrCode      String   @unique
  walletId    String   @unique
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  createdAt   DateTime @default(now())
}

// One row per user-facing event; the actual balance movements are its
// LedgerEntry children (one per wallet touched, two for a transfer).
model Transaction {
  id                String            @id @default(uuid())
  type              TransactionType
  status            TransactionStatus @default(COMPLETED)
  amount            Int
  currency          String            @default("XOF")
  idempotencyKey    String            @unique
  initiatorUserId   String
  initiator         User              @relation(fields: [initiatorUserId], references: [id])
  counterpartyLabel String?
  metadata          Json?
  createdAt         DateTime          @default(now())

  ledgerEntries LedgerEntry[]

  @@index([initiatorUserId])
}

model LedgerEntry {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  direction     LedgerDirection
  amount        Int
  balanceAfter  Int
  createdAt     DateTime        @default(now())

  @@unique([transactionId, walletId])
  @@index([walletId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

enum TontineKind {
  CLASSIQUE
  PROJET
}

enum ContributionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TontineGroupStatus {
  OPEN
  FULL
  COMPLETED
}

enum TontineVisibility {
  PUBLIC
  PRIVATE
}

// Configured by the back-office for the BingMoney catalog (createdByUserId
// null), or by a verified organizer via the Espace organisateur — both
// paths converge on the same engine (contributions, calendar, disbursement).
model TontineProduct {
  id                  String                @id @default(uuid())
  name                String
  kind                TontineKind
  theme               String?
  description         String
  contributionAmount  Int
  frequency           ContributionFrequency
  totalSlots          Int
  minTrustScore       Int                   @default(0)
  lateGracePeriodDays Int
  latePenaltyRateBps  Int // basis points (1/100 of a percent), e.g. 200 = 2%
  isActive            Boolean               @default(true)
  visibility          TontineVisibility     @default(PUBLIC)
  createdByUserId     String?
  createdBy           User?                 @relation("ProductCreator", fields: [createdByUserId], references: [id])
  createdAt           DateTime              @default(now())

  groups TontineGroup[]
}

model TontineGroup {
  id         String              @id @default(uuid())
  productId  String
  product    TontineProduct      @relation(fields: [productId], references: [id])
  label      String
  status     TontineGroupStatus  @default(OPEN)
  // Pot into which every member's contribution is credited and from which
  // a validated disbursement request pays the beneficiary out.
  walletId   String              @unique
  wallet     Wallet              @relation(fields: [walletId], references: [id])
  // Set only for PRIVATE (organizer-created) groups; how members join
  // without appearing in the public LesOffres catalog.
  inviteCode String?             @unique
  startedAt  DateTime            @default(now())
  createdAt  DateTime            @default(now())

  subscriptions        TontineSubscription[]
  validators           TontineValidator[]
  disbursementRequests DisbursementRequest[]
}

// The "3 personnes habilitées" for a group's décaissement validation
// (rule 8) — designated at tontine creation, distinct from membership.
model TontineValidator {
  id        String       @id @default(uuid())
  groupId   String
  group     TontineGroup @relation(fields: [groupId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
}

enum DisbursementStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ValidationDecision {
  APPROVED
  REJECTED
}

// Rule 9: the organizer can never move pot funds alone — a request only
// pays out once all 3 designated validators have approved it (unanimous).
model DisbursementRequest {
  id                String              @id @default(uuid())
  groupId           String
  group             TontineGroup        @relation(fields: [groupId], references: [id])
  subscriptionId    String
  subscription      TontineSubscription @relation(fields: [subscriptionId], references: [id])
  cycleNumber       Int
  amount            Int
  status            DisbursementStatus  @default(PENDING)
  requestedByUserId String
  requestedBy       User                @relation("DisbursementRequester", fields: [requestedByUserId], references: [id])
  transactionId     String?
  createdAt         DateTime            @default(now())
  decidedAt         DateTime?

  validations DisbursementValidation[]

  @@index([groupId])
}

model DisbursementValidation {
  id              String              @id @default(uuid())
  requestId       String
  request         DisbursementRequest @relation(fields: [requestId], references: [id])
  validatorUserId String
  validator       User                @relation(fields: [validatorUserId], references: [id])
  decision        ValidationDecision
  decidedAt       DateTime            @default(now())

  @@unique([requestId, validatorUserId])
}

model TontineSubscription {
  id           String   @id @default(uuid())
  groupId      String
  group        TontineGroup @relation(fields: [groupId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  turnNumber   Int
  subscribedAt DateTime @default(now())

  termsAcceptance TermsAcceptance?
  contributions   TontineContribution[]
  disbursementRequests DisbursementRequest[]

  @@unique([groupId, userId])
  @@unique([groupId, turnNumber])
  @@index([userId])
}

// Immutable record of what the member agreed to and when — the timestamp
// and the exact terms snapshot are what settle a dispute later.
model TermsAcceptance {
  id             String               @id @default(uuid())
  subscriptionId String               @unique
  subscription   TontineSubscription  @relation(fields: [subscriptionId], references: [id])
  acceptedAt     DateTime             @default(now())
  termsSnapshot  Json
}

model TontineContribution {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   TontineSubscription @relation(fields: [subscriptionId], references: [id])
  cycleNumber    Int
  dueDate        DateTime
  amount         Int
  paidAt         DateTime?
  transactionId  String?

  @@unique([subscriptionId, cycleNumber])
  @@index([subscriptionId])
}
